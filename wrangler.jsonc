{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cylm-portfolio",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "cylm.work",
      "custom_domain": true
    },
    {
      "pattern": "www.cylm.work",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
